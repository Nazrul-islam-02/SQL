CREATE TABLE Customers (
    Id INT PRIMARY KEY IDENTITY(1,1),
    FirstName VARCHAR(50),
    LastName VARCHAR(50),
    MiddleName VARCHAR(50),
    Age INT,
    Salary DECIMAL(10,2),
    Country VARCHAR(50),
    Score INT,
    Gender VARCHAR(10)
);



