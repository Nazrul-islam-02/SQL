1.a. Concat --COmbines multiple string into one
----01.--- get fullName use concat Function
select Id,
FirstName,
LastName,
CONCAT(FirstName,'  ',LastName) as FullName
from Customers

1.b) Upper
select Id,
FirstName,
upper(FirstName) as UpperCaseName
from Customers


1.c) Lower
select Id,
FirstName,
upper(FirstName) as UpperCaseName,
