---01---সব customers দেখাও তাদের orders সহ, কিন্তু শুধু সেই customers যারা order করেছ
select 
o.CustomerId,
c.FirstName,
c.Salary,
c.Country,
o.OrderDate,
o.Sales
from Customers c
inner join Orders o 
on c.Id = o.CustomerId
----Use Inner Join-----



-------02---Get all customers along with their orders, including orders without matching customers."---
select 
c.Id,
c.FirstName,
c.Salary,
c.Country,
o.OrderDate,
o.Sales,
o.CustomerId
from Customers c
right join Orders o 
on c.Id = o.CustomerId
